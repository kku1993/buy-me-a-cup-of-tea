# Stripe secret key (server-side only — never expose to the browser).
# Get it from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Connect only: connected account ID to act on behalf of. Leave
# unset for a standalone account. Setting this to an empty string will
# cause Stripe to reject requests with account_invalid (403).
# STRIPE_ACCOUNT_ID=acct_xxxxxxxxxxxxxxxx

# Port the backend listens on (default 8888).
PORT=8888

# CORS origin allowed to call the backend. Use "*" for dev, or your
# frontend origin (e.g. http://localhost:5173) in production.
ALLOWED_ORIGIN=*
